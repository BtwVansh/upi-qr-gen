# Optional: override the public site origin for forks or previews.
# Production uses https://upigenerator.netlify.app by default.
# NEXT_PUBLIC_SITE_URL=https://upigenerator.netlify.app

# Cloudflare Turnstile (required).
# The site key is public and is embedded in the browser bundle.
# Paste only the key itself, e.g. 0x4AAAAAAA... — never wrap it in <angle
# brackets> or quotes. Brackets are stripped defensively, but the clean value is
# what Cloudflare expects.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The secret key is server-only. Never prefix it with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
